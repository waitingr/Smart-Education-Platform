models/**/*.bin
models/**/*.pt
models/**/*.pth
models/**/*.gguf
models/**/*.onnx
models/**/*.h5
models/**/*.ckpt

# 只保留模型目录结构
!models/**/.gitkeep

# ========== 密钥与本地配置 ==========
.env
*.env
!.env.example
backend/.env

# ========== Python 缓存 ==========
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/
.conda/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

