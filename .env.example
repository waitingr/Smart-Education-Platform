# 复制本文件为项目根目录的 .env（或 backend/.env，两处都会被读取，根目录优先）
# .env 已在 .gitignore 中，不会被提交
# ============================================================================

# ---------------- 数据库 ----------------
# 推荐：不填则先尝试 MySQL，失败自动降级到本地 SQLite：data/smart_edu.db
# 想固定用 SQLite（演示推荐，数据不会跑偏）就打开下面这行：
# DATABASE_URL=sqlite:///data/smart_edu.db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=qwen_db

SECRET_KEY=please-change-to-a-random-string
FLASK_APP=app.py
FLASK_ENV=development

# ---------------- 生成模型（默认：本机 Ollama，可识图） ----------------
# auto   ：本机 Ollama（视觉模型）→ 本地权重 → 星火 → OpenAI 兼容 → 离线检索
# ollama ：强制用本机 Ollama 的视觉大模型（既能对话也能直接看图）
# local  ：直连 HuggingFace 权重（纯文本，需要 models/llm 下有权重）
# spark / openai / offline：云端或强制离线
LLM_PROVIDER=ollama

# 上下文预算（字符），附件与检索资料按此截断
LLM_CONTEXT_CHARS=6000
LLM_TIMEOUT=180
LLM_MAX_NEW_TOKENS=900

# 选了 ollama 时以下三项自动推导，无需填写：
#   LLM_BASE_URL   = <VISION_BASE_URL>/v1
#   LLM_API_KEY    = ollama（Ollama 不校验）
#   LLM_MODEL_NAME = <VISION_MODEL>
# 如需手动指定：
# LLM_MODEL_NAME=qwen3-vl:8b
# 直连本地权重时才需要：
# LLM_MODEL_PATH=models/llm/Qwen3-VL-8B-Instruct

# ---------------- 视觉模型（图片理解 / 读文档里的图） ----------------
VISION_PROVIDER=ollama
VISION_BASE_URL=http://127.0.0.1:11434
VISION_MODEL=qwen3-vl:8b          # 平台只用这一个模型（能识图 + 读文档）
VISION_TIMEOUT=180
# 视觉请求的 keep_alive：让 8B 模型常驻显存，避免每次冷启动约 20 秒
VISION_KEEP_ALIVE=30m

# 换成云端视觉服务时的写法：
# VISION_PROVIDER=openai
# VISION_BASE_URL=https://api.example.com/v1
# VISION_MODEL=qwen-vl-max
# VISION_API_KEY=sk-xxx

# 注意：Ollama 服务端的稳定运行参数（不在 .env 里，属于 Ollama 进程环境变量），
# 由 scripts/start_ollama.ps1 统一设置：
#   OLLAMA_KEEP_ALIVE=30m  OLLAMA_MAX_LOADED_MODELS=1
#   OLLAMA_NUM_PARALLEL=1  OLLAMA_FLASH_ATTENTION=1

# ---------------- 其它 ----------------
# EMBEDDING_BACKEND=hash
# KB_TOP_K=5
# 检索引擎：auto（默认，有 C++ 内核就用）/ python（强制纯 Python）/ cpp（强制内核）
# C++ 内核需要先编译：powershell -ExecutionPolicy Bypass -File scripts\build_kbcore.ps1
# KB_ENGINE=auto